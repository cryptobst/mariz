{{ header }}
<section class="gb-banner {{ heading_title }}">
    <div class="container">
        <div class="morepage-banner">
            <h2 class="title">{{ heading_title }}</h2>
            <ol class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                <li><a href="{{ breadcrumb.href }}" class="link">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ol>
        </div>
    </div>
</section>
<div class="gb-about-us padding-top-100 padding-bottom-100">
    <div class="container">
        <div class="main-content">
            <h1>{{ heading_title }}</h1> {{ text_message }}
        </div>
    </div>
</div>
{{ footer }}