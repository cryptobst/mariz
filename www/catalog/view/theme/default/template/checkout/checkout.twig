                    }, 'slow').promise().done(function () {
                        $('.account-title.che').html('{{ text_checkout_confirm }}')
                        $('.account-title.che').css('left','65%');
                        $('.line-grey').addClass('step6');
                        $('.line-grey').removeClass('step5');                        
                        $('.slide-checkout.active').hide();   
                        $(this).addClass('stepFin');
                        $(this).removeClass('active');                           
                        $('.slide-checkout .panel-collapse').removeClass('in');    
                        $('.slide-checkout.checkout-confirm').show();        
                        $('.slide-checkout.checkout-confirm').find('.panel-collapse').addClass('in');
                        $('.slide-checkout.checkout-confirm').animate({
                            "right": "0"
                        },'slow').promise().done(function () {            
                            $(this).addClass('active');            
                        });    
                    });       
                $.ajax({
                    url: 'index.php?route=checkout/confirm',
                    dataType: 'html',
                    complete: function() {
                        $('#button-payment-method').button('reset');
                    },
                    success: function(html) {
                        $('#collapse-checkout-confirm .panel-body').html(html);

						$('#collapse-checkout-confirm').parent().find('.panel-heading .panel-title').html('<a href="#collapse-checkout-confirm" data-toggle="collapse" data-parent="#accordion" class="accordion-toggle">{{ text_checkout_confirm }} <i class="fa fa-caret-down"></i></a>');

						// $('a[href=\'#collapse-checkout-confirm\']').trigger('click');
					},
                    error: function(xhr, ajaxOptions, thrownError) {
                        alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                    }
                });
            }
        },
        error: function(xhr, ajaxOptions, thrownError) {
            alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});
