{{ header }}
<div id="account-newsletter" class="container">
    <div class="row">
        <div id="content" class="col-sm-12">
            <div class="row">
                <div class="col-sm-offset-1 col-sm-10">
                    <div class="header-title">
                        <h1 class="account-title mg-b-40">{{ heading_title }}</h1>
                    </div>
                </div>
            </div>
            <form action="{{ action }}" method="post" enctype="multipart/form-data" class="form-horizontal">
                <div class="row">
                    <div class="col-sm-12">
                        <div class="form-group">
                            <label class="col-sm-2 control-label">{{ entry_newsletter }}</label>
                            <div class="col-sm-10">
                                {% if newsletter %}
                                <label class="radio-inline">
                                    <input type="radio" name="newsletter" value="1" checked="checked" /> {{ text_yes }} </label>
                                <label class="radio-inline">
                                    <input type="radio" name="newsletter" value="0" /> {{ text_no }}</label>
                                {% else %}
                                <label class="radio-inline">
                                    <input type="radio" name="newsletter" value="1" /> {{ text_yes }} </label>
                                <label class="radio-inline">
                                    <input type="radio" name="newsletter" value="0" checked="checked" /> {{ text_no }}</label>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row" style="margin-top:40px;">
                    <div class="col-sm-offset-1 col-sm-4 btn-fixed-left">
                        <a href="{{ back }}" class="btn custom-prmbtn btn-fill-gold-not-hover">{{ button_back }}</a></div>
                    <div class="col-sm-offset-2 col-sm-4 btn-fixed-right">
                        <input type="submit" value="{{ button_continue }}" class="btn custom-prmbtn btn-gold" />
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
{{ footer }}