{{ header }}
<div id="account-login" class="container">
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}</div>
    {% endif %} {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
    {% endif %}
    <div class="row">
        <div id="content" class="col-sm-12">
            <div class="row custom-form-row">
                <div class="col-sm-6">
                    <div>
                        <h2 class="account-title">{{ text_returning_customer }}</h2>
                        <form action="{{ action }}" method="post" enctype="multipart/form-data">
                            <div class="form-group">
                                <label class="custom-label" for="input-email">{{ entry_email }}</label>
                                <input type="text" name="email" value="{{ email }}" id="input-email" class="input-custom" />
                            </div>
                            <div class="form-group">
                                <label class="custom-label" for="input-password">{{ entry_password }}</label>
                                <input type="password" name="password" value="{{ password }}" id="input-password" class="input-custom" />
                                <a class="f-11" href="{{ forgotten }}">{{ text_forgotten }}</a></div>
                            <input type="submit" value="{{ button_login }}" class="btn custom-prmbtn btn-fill-gold mg-t-15" /> {% if redirect %}
                            <input type="hidden" name="redirect" value="{{ redirect }}" /> {% endif %}
                        </form>
                    </div>
                </div>
                <div class="col-sm-6">
                    <h2 class="account-title">{{ text_new_customer }}</h2>
                    <div class="btn-holder">
                        <a href="{{ register }}" class="btn custom-prmbtn btn-gold">{{ text_create_account }}</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{{ footer }}