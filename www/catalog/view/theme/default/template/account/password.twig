{{ header }}
<div id="account-password" class="container">
    <div class="row">
        <div id="content" class="col-sm-12">
            <div class="row">
                <div class="col-sm-offset-1 col-sm-10">
                    <div class="header-title">
                        <h1 class="account-title mg-b-40">{{ heading_title }}</h1>
                    </div>
                </div>
            </div>
            <form action="{{ action }}" method="post" enctype="multipart/form-data" class="form-horizontal">
                <div class="row">
                    <div class="col-sm-offset-2 col-sm-4">
                        <div class="form-group required">
                            <label class="custom-label" for="input-password">{{ entry_password }}</label>
                            <input type="password" name="password" value="{{ password }}" placeholder="{{ entry_password }}" id="input-password" class="input-custom wid99" /> {% if error_password %}
                            <div class="text-danger">{{ error_password }}</div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="form-group required">
                            <label class="custom-label" for="input-confirm">{{ entry_confirm }}</label>
                            <input type="password" name="confirm" value="{{ confirm }}" placeholder="{{ entry_confirm }}" id="input-confirm" class="input-custom wid99" /> {% if error_confirm %}
                            <div class="text-danger">{{ error_confirm }}</div>
                            {% endif %}
                        </div>
                    </div>
                </div>               
                <div class="row">
                    <div class="col-sm-offset-1 col-sm-4 btn-fixed-left">
                        <a href="{{ back }}" class="btn custom-prmbtn btn-fill-gold-not-hover">{{ button_back }}</a></div>
                    <div class="col-sm-offset-2 col-sm-4 btn-fixed-right">
                        <input type="submit" value="{{ button_continue }}" class="btn custom-prmbtn btn-gold" />
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
{{ footer }}