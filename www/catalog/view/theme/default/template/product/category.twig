{{ header }}
<section class="gb-banner banner-08" {% if thumb %}style="background-position: top center;background-image:url({{thumb ? thumb : '' }})!important" {% endif %}>
    <div class="container">
        <div class="morepage-banner">
            <h2 class="title">{{ heading_title }}</h2>
            <ol class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                <li><a href="{{ breadcrumb.href }}" class="link">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ol>
        </div>
    </div>
</section>
<section class="product-section">
    <div class="container">
        <div class="row text-right">         
            <div class="col-md-6 col-xs-6 pull-right">
                <div class="inline-block">
                    <label class="title">{{ text_sort }}</label>                    
                    <div class="form-group input-group input-group-sm filters">
                        <select id="input-sort" class="form-control height-24" onchange="location = this.value;">
                            {% for sorts in sorts %} {% if sorts.value == '%s-%s'|format(sort, order) %}
                            <option value="{{ sorts.href }}" selected="selected">{{ sorts.text }}</option>
                            {% else %}
                            <option value="{{ sorts.href }}">{{ sorts.text }}</option>
                            {% endif %} {% endfor %}
                        </select>
                    </div>
                </div>
                <div class="inline-block">
                    <label class="title">{{ text_limit }}</label>                    
                    <div class="form-group input-group input-group-sm filters">
                        <div class="list-group">
                            {% for limits in limits %} {% if limits.value == limit %}
                            <a href="{{ limits.href }}" class="list-group-item active" style="font-size:12px">{{ limits.text }}</a> {% else %}
                            <a href="{{ limits.href }}" class="list-group-item" style="font-size:12px">{{ limits.text }}</a> {% endif %} {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {#
        <div class="line-bg"></div> #}
        <div class="row">
            <div class="col-md-3">
                {{ content_top }}
            </div>
            <div class="col-md-9">
                {% for productRow in products|batch(3) %}
                    <div class="row"> 
                        {% for product in productRow %}
                    <div class="product-layout product-grid col-lg-4 col-md-4 col-sm-6 col-xs-12">
                        <div class="product-thumb">
                            {% if product.special %}
                            <div id='octagon'>
                                <span>On Sale</span>
                            </div>
                            {% endif %}
                            <div class="image">
                                <div class="overlay">
                                    <a href="{{ product.href }}" class="overlay-anchor"></a>
                                    <h4 class="text-center" style="margin-top: 25%;"><a href="{{ product.href }}">{{ product.name }}</a></h4>
                                    <p class="text-center" class="price">
                                        {% if not product.special %} {{ product.price }} {% else %}
                                        <span class="price"><a href="{{ product.href }}">
                                        <ins>{{ product.special }}</ins>
                                        <del>{{ product.price }}</del> 
                                        </a>               
                                    </span> {% endif %}
                                    </p>
                                    <div class="text-center" style="display:none;">
                                        <button style="margin-left: 0;" type="button" class="add-to-cart-btn" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');"><i class="fa fa-shopping-cart"></i></button>
                                    </div>
                                </div>
                                <div class="text-center"> 
                                <a href="{{ product.href }}" style="text-align:center"><img style="margin: 0 auto;" src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" class="img-responsive" /> {{ product.name }}</a>
                            </div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}   
                    </div>
                {% endfor %}                
            </div>
        </div>
        <div class="row">
            <div class="col-sm-12 text-center">{{ pagination }}</div>
            <div class="col-sm-12 text-center res">{{ results }}</div>
        </div>
    </div>
</section>
{# {{ column_left }} #} {#
<div id="product-category" class="container">
    <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
    </ul>
    <div class="row">{{ column_left }} {% if column_left and column_right %} {% set class = 'col-sm-6' %} {% elseif column_left or column_right %} {% set class = 'col-sm-9' %} {% else %} {% set class = 'col-sm-12' %} {% endif %}
        <div id="content" class="{{ class }}">{{ content_top }}
            <h2>{{ heading_title }}</h2> {% if thumb or description %}
            <div class="row"> {% if thumb %}
                <div class="col-sm-2"><img src="{{ thumb }}" alt="{{ heading_title }}" title="{{ heading_title }}" class="img-thumbnail" /></div>
                {% endif %} {% if description %}
                <div class="col-sm-10">{{ description }}</div>
                {% endif %}</div>
            <hr> {% endif %} {% if categories %}
            <h3>{{ text_refine }}</h3> {% if categories|length
            <=5 %} <div class="row">
                <div class="col-sm-3">
                    <ul>
                        {% for category in categories %}
                        <li><a href="{{ category.href }}">{{ category.name }}</a></li>
                        {% endfor %}
                    </ul>
                </div>
        </div>
        {% else %}
        <div class="row">{% for category in categories|batch((categories|length / 4)|round(1, 'ceil')) %}
            <div class="col-sm-3">
                <ul>
                    {% for child in category %}
                    <li><a href="{{ child.href }}">{{ child.name }}</a></li>
                    {% endfor %}
                </ul>
            </div>
            {% endfor %}</div>
        <br /> {% endif %} {% endif %} {% if products %}
        <div class="row">
            <div class="col-md-2 col-sm-6 hidden-xs">
                <div class="btn-group btn-group-sm">
                    <button type="button" id="list-view" class="btn btn-default" data-toggle="tooltip" title="{{ button_list }}"><i class="fa fa-th-list"></i></button>
                    <button type="button" id="grid-view" class="btn btn-default" data-toggle="tooltip" title="{{ button_grid }}"><i class="fa fa-th"></i></button>
                </div>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="form-group"><a href="{{ compare }}" id="compare-total" class="btn btn-link">{{ text_compare }}</a></div>
            </div>
            <div class="col-md-4 col-xs-6">
                <div class="form-group input-group input-group-sm">
                    <label class="input-group-addon" for="input-sort">{{ text_sort }}</label>
                    <select id="input-sort" class="form-control" onchange="location = this.value;">
                        {% for sorts in sorts %} {% if sorts.value == '%s-%s'|format(sort, order) %}
                        <option value="{{ sorts.href }}" selected="selected">{{ sorts.text }}</option>
                        {% else %}
                        <option value="{{ sorts.href }}">{{ sorts.text }}</option>
                        {% endif %} {% endfor %}
                    </select>
                </div>
            </div>
            <div class="col-md-3 col-xs-6">
                <div class="form-group input-group input-group-sm">
                    <label class="input-group-addon" for="input-limit">{{ text_limit }}</label>
                    <select id="input-limit" class="form-control" onchange="location = this.value;">
                        {% for limits in limits %} {% if limits.value == limit %}
                        <option value="{{ limits.href }}" selected="selected">{{ limits.text }}</option>
                        {% else %}
                        <option value="{{ limits.href }}">{{ limits.text }}</option>
                        {% endif %} {% endfor %}
                    </select>
                </div>
            </div>
        </div>
        <div class="row"> {% for product in products %}
            <div class="product-layout product-list col-xs-12">
                <div class="product-thumb">
                    <div class="image"><a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" title="{{ product.name }}" class="img-responsive" /></a></div>
                    <div>
                        <div class="caption">
                            <h4><a href="{{ product.href }}">{{ product.name }}</a></h4>
                            <p>{{ product.description }}</p>
                            {% if product.price %}
                            <p class="price"> {% if not product.special %} {{ product.price }} {% else %} <span class="price-new">{{ product.special }}</span> <span class="price-old">{{ product.price }}</span> {% endif %} {% if product.tax %} <span class="price-tax">{{ text_tax }} {{ product.tax }}</span> {% endif %} </p>
                            {% endif %} {% if product.rating %}
                            <div class="rating"> {% for i in 1..5 %} {% if product.rating
                                < i %} <span class="fa fa-stack"><i class="fa fa-star-o fa-stack-2x"></i></span> {% else %} <span class="fa fa-stack"><i class="fa fa-star fa-stack-2x"></i><i class="fa fa-star-o fa-stack-2x"></i></span>{% endif %} {% endfor %} </div>
                            {% endif %} </div>
                        <div class="button-group">
                            <button type="button" style="display:none;" onclick="cart.add('{{ product.product_id }}', '{{ product.minimum }}');"><i class="fa fa-shopping-cart"></i> <span class="hidden-xs hidden-sm hidden-md">{{ button_cart }}</span></button>
                            <button type="button" data-toggle="tooltip" title="{{ button_wishlist }}" onclick="wishlist.add('{{ product.product_id }}');"><i class="fa fa-heart"></i></button>
                            <button type="button" data-toggle="tooltip" title="{{ button_compare }}" onclick="compare.add('{{ product.product_id }}');"><i class="fa fa-exchange"></i></button>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %} </div>
        <div class="row">
            <div class="col-sm-6 text-left">{{ pagination }}</div>
            <div class="col-sm-6 text-right">{{ results }}</div>
        </div>
        {% endif %} {% if not categories and not products %}
        <p>{{ text_empty }}</p>
        <div class="buttons">
            <div class="pull-right"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
        </div>
        {% endif %} {{ content_bottom }}</div>
    {{ column_right }}</div>
</div> #} {{ footer }}